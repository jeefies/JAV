[Unit]
Description=JAV - Jeefy Audio-Video Generation Platform
Documentation=file:///mnt/data/AV/JAV-DESIGN.md
After=network-online.target
Wants=network-online.target
# crash-loop protection: park the service after 3 failures in 10 min
# (each restart re-runs the orphan sweep + crash recovery; never loop that)
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/mnt/data/AV/JAV
Environment=PYTHONPATH=/mnt/data/AV/JAV
Environment=HF_HOME=/mnt/data/AV/JAV/data/hf_home
ExecStart=/home/jeefy/miniconda3/envs/comfyui/bin/python3 -m uvicorn jav.server:create_app --factory --host 127.0.0.1 --port 8765 --log-level info

Restart=on-failure
RestartSec=5
KillMode=mixed
# Worst-case graceful stop budget (keep in sync with jav/scheduler.py stop
# wait + comfy /free + terminate wait + supervisor VRAM verification):
# 90 + 10 + 15 + 30 = ~145s. Must exceed it or systemd SIGKILLs CUDA children
# mid-teardown, leaving driver-level "ghost" VRAM (see AGENTS.md 已知坑).
TimeoutStopSec=180

# Hard cgroup caps: any runaway pipeline/ComfyUI child is OOM-killed INSIDE
# this unit's cgroup first, never globally (protects unichess training).
# memory.max is the RAM+SWAP sum: the ZIT derived-pipeline (i2i/inpaint) cast
# peak measures ~29.2G, so the cap must sit above it or the cgroup thrashes
# forever (28G cap froze the worker mid-cast for 45min on 2026-09-30).
MemoryHigh=31G
MemoryMax=34G
MemorySwapMax=20G

NoNewPrivileges=true

[Install]
WantedBy=default.target
